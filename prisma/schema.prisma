generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/**
 * KNOOS User model.
 * role: CUSTOMER | ADMIN
 * Authentication is handled via Google OAuth (next-auth).
 */
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  googleId  String?  @unique
  image     String?
  role      String   @default("CUSTOMER") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  addresses Address[]
  carts     Cart[]
  orders    Order[]

  @@index([email])
  @@index([googleId])
}

/**
 * Product category: MEN or WOMEN.
 */
model Product {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  description String?   @db.Text
  gender      String    @db.VarChar(10)
  price       Int
  salePrice   Int?
  sku         String    @unique @db.VarChar(100)
  status      String    @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @db.DateTime(0)
  updatedAt   DateTime  @updatedAt @db.DateTime(0)

  images    ProductImage[]
  variants  ProductVariant[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([gender, status])
  @@index([slug])
  @@index([status, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @db.VarChar(36)
  imageUrl  String  @db.VarChar(500)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String  @db.VarChar(36)
  size      String  @db.VarChar(10)
  stock     Int     @default(0)
  sku       String  @unique @db.VarChar(100)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([productId, size])
  @@index([productId])
}

/**
 * Delivery address linked to a user.
 */
model Address {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(36)
  name      String   @db.VarChar(100)
  phone     String   @db.VarChar(20)
  address   String   @db.VarChar(500)
  city      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  pincode   String   @db.VarChar(10)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * One cart per user. A user has at most one cart at a time.
 */
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @db.VarChar(36)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @db.VarChar(36)
  productId String   @db.VarChar(36)
  variantId String   @db.VarChar(36)
  quantity  Int

  cart    Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

/**
 * Order. Payment and delivery amounts are authoritative server-side values.
 */
model Order {
  id                String     @id @default(cuid())
  userId            String     @db.VarChar(36)
  subtotal          Int
  deliveryCharge    Int
  total             Int
  deliveryMethod    String     @db.VarChar(20)
  orderStatus       String     @default("PENDING") @db.VarChar(20)
  paymentStatus     String     @default("PENDING") @db.VarChar(20)
  razorpayOrderId   String?    @unique @db.VarChar(100)
  razorpayPaymentId String?    @unique @db.VarChar(100)
  razorpaySignature String?
  createdAt         DateTime   @default(now()) @db.DateTime(0)
  updatedAt         DateTime   @updatedAt @db.DateTime(0)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([userId, createdAt])
  @@index([orderStatus, paymentStatus])
}

/**
 * Snapshot of a product at purchase time.
 * productName, size, price are denormalised so historical orders are immutable
 * even if the product is later edited.
 */
model OrderItem {
  id           String  @id @default(cuid())
  orderId      String  @db.VarChar(36)
  productId    String? @db.VarChar(36)
  productName  String  @db.VarChar(255)
  size         String  @db.VarChar(10)
  quantity     Int
  price        Int
  total        Int

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}
